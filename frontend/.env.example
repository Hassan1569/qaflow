# QAFlow Frontend — Environment Configuration
# Copy this file to `.env` and adjust as needed.

# The base URL for API requests. 
# In development, Vite proxies `/api` to the PHP backend (see vite.config.js),
# so you can leave this as `/api`. In production, this might be a full URL
# like `https://qaflow.example.com/api` if hosted on a different domain.
VITE_API_BASE_URL=/api