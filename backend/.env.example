# QAFlow Backend — Environment Configuration
# Copy this file to `.env` and adjust the values.
# `.env` is gitignored; never commit real credentials.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=local
APP_DEBUG=true
APP_NAME=QAFlow
APP_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Database (MySQL 8)
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=qaflow
DB_USER=qaflow
DB_PASS=change-me
DB_CHARSET=utf8mb4

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins.
# Use http://localhost:5173 for the Vite dev server.
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Hours until an issued bearer token expires.
TOKEN_TTL_HOURS=24

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
# Requests per minute per IP for the login endpoint.
LOGIN_RATE_LIMIT_PER_MIN=10

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Relative to the backend/ directory. Must not be inside public/.
UPLOAD_DIR=storage/uploads
LOG_DIR=storage/logs

# Max upload size in bytes (10 MB).
UPLOAD_MAX_BYTES=10485760

# Comma-separated list of allowed MIME types for uploads.
UPLOAD_ALLOWED_MIME=image/png,image/jpeg,image/webp,application/pdf,text/plain,text/csv,application/zip

# ---------------------------------------------------------------------------
# Features
# ---------------------------------------------------------------------------
# AI suggestion service is a stub. Leave off unless a provider is wired.
AI_ENABLED=false

# ---------------------------------------------------------------------------
# Timezone
# ---------------------------------------------------------------------------
APP_TIMEZONE=UTC