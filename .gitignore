# QAFlow — Git Ignore

# ---------------------------
# Environment
# ---------------------------
.env
.env.local
.env.*.local
!.env.example

# ---------------------------
# Backend
# ---------------------------
backend/storage/logs/
backend/storage/uploads/
backend/vendor/
backend/composer.lock
backend/.php-cs-fixer.cache

# Keep directory placeholders
!backend/storage/.gitkeep

# ---------------------------
# Frontend
# ---------------------------
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/.cache/
frontend/coverage/
frontend/.env
frontend/.env.local
frontend/.env.*.local
!frontend/.env.example

# ---------------------------
# Editors / OS
# ---------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------
# Logs / Temp
# ---------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
tmp/
temp/

# ---------------------------
# Build artifacts
# ---------------------------
*.min.css
*.min.js
!frontend/src/**/*.min.css
!frontend/src/**/*.min.js

# ---------------------------
# Misc
# ---------------------------
*.sqlite
*.sqlite3
.DS_Store